# syntax=docker/dockerfile:1.7-labs
# Isolated remote client for the local end-to-end run (apps/e2e/docker/run.ts).
# Build from the repository root. The deps stage is byte-identical to
# apps/relay/Dockerfile so BuildKit reuses that layer instead of re-installing
# the workspace.
FROM oven/bun:1.4.2-slim AS deps
WORKDIR /app

COPY package.json bun.lock turbo.json ./
COPY patches patches
COPY --parents apps/*/package.json packages/*/package.json scripts/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts

# Bundle the actual TLS client and shared protocol for Node; Bun only builds it.
COPY packages packages
COPY apps/server/src apps/server/src
COPY apps/server/package.json apps/server/package.json
COPY apps/e2e apps/e2e
RUN bun build apps/e2e/docker/client.ts --target=node --outfile=/app/client.mjs

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update -qq \
  && apt-get install -y -qq --no-install-recommends iptables util-linux >/dev/null \
  && rm -rf /var/lib/apt/lists/*
COPY --from=deps /app/client.mjs /app/client.mjs
COPY --chmod=755 apps/e2e/docker/client-entrypoint.sh /usr/local/bin/client-entrypoint
ENTRYPOINT ["client-entrypoint"]
